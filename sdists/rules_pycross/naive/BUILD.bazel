py_test(
    name = "sdist_test",
    srcs = ["//:project/src/check_sdists.py"],
    main = "//:project/src/check_sdists.py",
    tags = ["manual"],
    deps = [
        "@pypi_naive//crcmod",
        "@pypi_naive//datrie",
    ],
)
