load("@rules_python//python:defs.bzl", "py_test")

# unishell <-> unishell-unix is active on Linux/macOS; unishell <-> unishell-win
# is gated on sys_platform == 'win32'. Depending on unishell or unishell_unix on
# Linux must include both without pulling in unishell_win; depending directly on
# unishell_win must include unishell_win along with unishell and unishell_unix.

py_test(
    name = "unishell_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["unishell"],
    main = "project/src/check_cycle.py",
    deps = ["@pypi//unishell"],
)

py_test(
    name = "unishell_unix_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["unishell_unix"],
    main = "project/src/check_cycle.py",
    deps = ["@pypi//unishell_unix"],
)

py_test(
    name = "unishell_win_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["unishell_win"],
    main = "project/src/check_cycle.py",
    deps = ["@pypi//unishell_win"],
)
