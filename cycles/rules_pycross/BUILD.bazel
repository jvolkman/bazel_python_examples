load("@rules_python//python:defs.bzl", "py_test")

# apache-airflow==3.4.0 has an 8-package base cycle, plus apache-tinkerpop as
# a 9th member gated on `python_version != "3.14"`. On Python 3.14, depending on
# apache_airflow must pull in the active 8-package cycle without tinkerpop or
# gremlin_python; depending directly on apache_airflow_providers_apache_tinkerpop
# must keep tinkerpop, gremlin_python, and airflow.

py_test(
    name = "airflow_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["airflow"],
    main = "project/src/check_cycle.py",
    deps = ["@pypi//apache_airflow"],
)

py_test(
    name = "tinkerpop_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["tinkerpop"],
    main = "project/src/check_cycle.py",
    deps = ["@pypi//apache_airflow_providers_apache_tinkerpop"],
)
