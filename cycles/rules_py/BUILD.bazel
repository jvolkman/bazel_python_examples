load("@rules_py//py:defs.bzl", "py_test")

exports_files(glob(["project/**"]))

# kedro and kedro-telemetry depend on each other. Each test depends on only
# one side of the cycle and verifies both packages and their unique transitive
# dependencies (dynaconf and requests) are importable.

py_test(
    name = "kedro_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["kedro"],
    dep_group = "cycle-app",
    main = "project/src/check_cycle.py",
    deps = ["@pypi//kedro"],
)

py_test(
    name = "telemetry_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["kedro_telemetry"],
    dep_group = "cycle-app",
    main = "project/src/check_cycle.py",
    deps = ["@pypi//kedro_telemetry"],
)
