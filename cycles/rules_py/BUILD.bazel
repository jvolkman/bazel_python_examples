load("@rules_py//py:defs.bzl", "py_test")

exports_files(glob(["project/**"]))

# unishell <-> unishell-unix is active on Linux/macOS; unishell <-> unishell-win
# is gated on sys_platform == 'win32'.

py_test(
    name = "unishell_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["unishell"],
    dep_group = "cycle-app",
    main = "project/src/check_cycle.py",
    deps = ["@pypi//unishell"],
)

py_test(
    name = "unishell_unix_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["unishell_unix"],
    dep_group = "cycle-app",
    main = "project/src/check_cycle.py",
    deps = ["@pypi//unishell_unix"],
)

# Reproduces the rules_py collect_sccs bug: tagged manual so `bazel test //...`
# passes. Even though @pypi//unishell_win is a direct dep, rules_py collapses
# {unishell, unishell-unix, unishell-win} into one SCC and gates unishell-win on
# its inbound intra-SCC edge marker (sys_platform == 'win32'), silently dropping
# unishell_win itself on Linux.
py_test(
    name = "unishell_win_test",
    srcs = ["project/src/check_cycle.py"],
    args = ["unishell_win"],
    dep_group = "cycle-app",
    main = "project/src/check_cycle.py",
    tags = ["manual"],
    deps = ["@pypi//unishell_win"],
)
