module(name = "conflicts_rules_pycross")

bazel_dep(name = "rules_pycross")
git_override(
    module_name = "rules_pycross",
    commit = "bd4800c5abacdfcc2a9053872f82e1bdd19ce22c",
    remote = "https://github.com/jvolkman/rules_pycross.git",
)
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")

# One workspace = one lock file. Every repo below is a view onto the same
# backing package repo, so numpy is fetched once and shared.
uv.workspace(
    name = "torch",
    lock_file = "//:project/uv.lock",
)

# Naive: one repo with both conflicting extras. uv's `conflicts` become
# `_variants` bool flags on this repo, and the variant must be chosen on the
# command line (`--@pypi//_variants:extra_cpu=True`).
uv.repo(
    name = "pypi",
    dependency_groups = [
        "default",
        "optional:cpu",
        "optional:cu132",
    ],
    workspace = "torch",
)

# Per-variant views: each requests only one extra from the conflict set, so
# rules_pycross selects that variant automatically with no `flags` needed.
# Targets that depend on @torch_cpu or @torch_cu132 build side by side in one
# `bazel test //...`.
uv.repo(
    name = "torch_cpu",
    dependency_groups = [
        "default",
        "optional:cpu",
    ],
    workspace = "torch",
)
uv.repo(
    name = "torch_cu132",
    dependency_groups = [
        "default",
        "optional:cu132",
    ],
    workspace = "torch",
)
use_repo(uv, "pypi", "torch_cpu", "torch_cu132")
