module(name = "conflicts_rules_pycross")

bazel_dep(name = "rules_pycross", version = "2.2.0")
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14",
)

# Register `@pypi//_variants` so py_test/py_binary targets can pick a variant
# with `config_settings = {"@pypi//_variants": ...}`.
config = use_extension("@rules_python//python/extensions:config.bzl", "config")
config.add_transition_setting(setting = "@pypi//_variants")

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")

# One workspace = one lock file, and one `@pypi` repo covering both conflicting
# extras. Variant-independent packages like numpy install once across variants.
uv.workspace(
    name = "torch",
    lock_file = "//:project/uv.lock",
)
uv.repo(
    name = "pypi",
    dependency_groups = [
        "default",
        "optional:cpu",
        "optional:cu132",
    ],
    workspace = "torch",
)
use_repo(uv, "pypi")
