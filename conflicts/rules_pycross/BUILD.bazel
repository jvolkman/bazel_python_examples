load("@rules_python//python:defs.bzl", "py_test")

exports_files(["project/src/check_torch.py"])

# Both tests depend on the same `@pypi` repo and pick their uv conflict variant
# via `config_settings` on `@pypi//_variants`, so both run in one `bazel test //...`.
py_test(
    name = "torch_cpu_test",
    srcs = ["project/src/check_torch.py"],
    args = ["cpu"],
    config_settings = {
        "@pypi//_variants": "extra_cpu",
    },
    main = "project/src/check_torch.py",
    deps = [
        "@pypi//numpy",
        "@pypi//torch",
    ],
)

py_test(
    name = "torch_cu132_test",
    srcs = ["project/src/check_torch.py"],
    args = ["cu132"],
    config_settings = {
        "@pypi//_variants": "extra_cu132",
    },
    main = "project/src/check_torch.py",
    deps = [
        "@pypi//numpy",
        "@pypi//torch",
    ],
)
