load("@rules_python//python:defs.bzl", "py_test")

# Naive approach: depend on `@pypi` without `config_settings` and pick the
# variant on the command line. Without a flag this fails at analysis time, so
# it is `manual` and excluded from `bazel test //...`:
#
#   bazel test //naive:torch_test --@pypi//_variants=extra_cpu --test_arg=cpu
#   bazel test //naive:torch_test --@pypi//_variants=extra_cu132 --test_arg=cu132
py_test(
    name = "torch_test",
    srcs = ["//:project/src/check_torch.py"],
    main = "//:project/src/check_torch.py",
    tags = ["manual"],
    deps = [
        "@pypi//numpy",
        "@pypi//torch",
    ],
)
