load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")

exports_files(glob(["*.txt"]))

# `bazel run //requirements:<variant>.update` re-exports the file from the
# shared uv.lock; `//requirements:<variant>_test` checks it is up to date.
[
    [
        py_binary(
            name = variant + ".update",
            srcs = ["//tools:export_requirements.py"],
            args = [
                "--uv=$(rootpath @rules_python//python/uv/bin:uv)",
                "--project=project",
                "--output=requirements/{}.txt".format(variant),
                "--",
                "--no-emit-project",
                "--no-dev",
                "--extra={}".format(variant),
            ],
            data = ["@rules_python//python/uv/bin:uv"],
            main = "//tools:export_requirements.py",
        ),
        py_test(
            name = variant + "_test",
            srcs = ["//tools:export_requirements.py"],
            args = [
                "--uv=$(rootpath @rules_python//python/uv/bin:uv)",
                "--project=project",
                "--output=requirements/{}.txt".format(variant),
                "--check",
                "--",
                "--no-emit-project",
                "--no-dev",
                "--extra={}".format(variant),
            ],
            data = [
                variant + ".txt",
                "//:project/pyproject.toml",
                "//:project/uv.lock",
                "@rules_python//python/uv/bin:uv",
            ],
            main = "//tools:export_requirements.py",
        ),
    ]
    for variant in ["cpu", "cu132"]
]
