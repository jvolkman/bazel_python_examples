module(name = "conflicts_rules_python")

bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Pointing pip.parse(uv_lock = ...) at the shared project/uv.lock fails (see
# naive/). Instead, maintain one uv.lock per torch variant (no [tool.uv]
# conflicts) and let rules_python's unified @pypi hub route between them via
# @rules_python//python/config_settings:venv.
pip.default(default_hub = "pypi_cpu")

pip.parse(
    hub_name = "pypi_cpu",
    python_version = "3.12",
    uv_lock = "//variants/cpu:uv.lock",
)
pip.parse(
    hub_name = "pypi_cu132",
    python_version = "3.12",
    uv_lock = "//variants/cu132:uv.lock",
)
use_repo(pip, "pypi")
