load("@rules_python//python:py_test.bzl", "py_test")

exports_files([
    "project/pyproject.toml",
    "project/uv.lock",
])

py_test(
    name = "torch_cpu_test",
    srcs = ["project/src/check_torch.py"],
    args = ["cpu"],
    config_settings = {"@rules_python//python/config_settings:venv": "pypi_cpu"},
    main = "project/src/check_torch.py",
    deps = [
        "@pypi//numpy",
        "@pypi//torch",
    ],
)

