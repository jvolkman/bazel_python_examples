module(name = "workspaces_rules_py")

bazel_dep(name = "rules_py", version = "2.0.0-alpha.11")

# rules_py provisions its own interpreters (python-build-standalone).
interpreters = use_extension("@rules_py//py:extensions.bzl", "python_interpreters")
interpreters.toolchain(python_version = "3.14")
use_repo(interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

uv = use_extension("@rules_py//uv:extensions.bzl", "uv")

# ONE hub over the shared uv.lock. The lock is registered twice, with two
# Bazel-only pyproject.toml files that only differ in their dependency groups:
#   "prod"                     - implicit all-members group (bazel/prod)
#   "app-a-test", "app-b-test" - per-app test environments (bazel/tests)
uv.declare_hub(hub_name = "pypi")
uv.project(
    hub_name = "pypi",
    lock = "//:project/uv.lock",
    pyproject = "//bazel/prod:pyproject.toml",
)
uv.project(
    hub_name = "pypi",
    lock = "//:project/uv.lock",
    pyproject = "//bazel/tests:pyproject.toml",
)

# Every editable workspace member in uv.lock must be mapped to a Bazel target,
# otherwise the extension fails.
[
    uv.override_package(
        name = name,
        lock = "//:project/uv.lock",
        target = target,
    )
    for name, target in [
        ("common", "//:common"),
        ("app-a", "//:app_a"),
        ("app-b", "//:app_b"),
    ]
]

use_repo(uv, "pypi")

# Naive approach, for comparison: a hub straight from the shared workspace
# root. See naive/BUILD.bazel and the README.
uv.declare_hub(hub_name = "pypi_naive")
uv.project(
    hub_name = "pypi_naive",
    lock = "//:project/uv.lock",
    pyproject = "//:project/pyproject.toml",
)
use_repo(uv, "pypi_naive")
