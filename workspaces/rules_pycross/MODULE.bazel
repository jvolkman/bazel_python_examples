module(name = "workspaces_rules_pycross")

bazel_dep(name = "rules_pycross")
git_override(
    module_name = "rules_pycross",
    commit = "8d78809639063b1582dfda0bd78a39dc8b967ff8",
    remote = "https://github.com/jvolkman/rules_pycross.git",
)
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Register `@pypi//_variants` so py_test targets can pick their member's
# conflicting `test` group via `config_settings`.
config = use_extension("@rules_python//python/extensions:config.bzl", "config")
config.add_transition_setting(setting = "@pypi//_variants")

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")

# One workspace = one uv.lock. Members (libs/common, apps/app-a, apps/app-b)
# are discovered from the lock's [manifest].
uv.workspace(
    name = "mono",
    lock_file = "//:project/uv.lock",
)

# Single hub: default runtime deps plus each member's test group (marked
# testonly so py_library targets cannot depend on pytest). There is no member
# list to maintain, and the root `dev` group is never selected, so
# [dependency-groups] stays in pyproject.toml untouched.
uv.repo(
    name = "pypi",
    dependency_groups = [
        "default",
        "group:test;testonly",
    ],
    projects = ["*"],
    workspace = "mono",
)
use_repo(uv, "pypi")
