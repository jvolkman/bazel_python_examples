module(name = "workspaces_rules_pycross")

bazel_dep(name = "rules_pycross")
git_override(
    module_name = "rules_pycross",
    commit = "e81bcb316331ab1c3741eefc09c1e09ddf5372b1",
    remote = "https://github.com/jvolkman/rules_pycross.git",
)
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")

# One workspace = one uv.lock. Members (libs/common, apps/app-a, apps/app-b)
# are discovered from the lock's [manifest].
uv.workspace(
    name = "mono",
    lock_file = "//:project/uv.lock",
)

# The hub: default (runtime) dependencies of every workspace member. There is no
# member list to maintain, and the root `dev` group is simply not selected, so
# [dependency-groups] stays in pyproject.toml untouched.
uv.repo(
    name = "pypi",
    dependency_groups = ["default"],
    projects = ["*"],
    workspace = "mono",
)

# Test-only views onto the same workspace. Each requests one member's
# conflicting `test` group, so rules_pycross selects its variant automatically
# with no `flags` or `config_settings` needed on test targets. All three repos
# share one backing package repo, so variant-independent packages are fetched
# and installed once.
uv.repo(
    name = "pypi_test_a",
    dependency_groups = ["group:test;testonly"],
    projects = ["app-a"],
    workspace = "mono",
)
uv.repo(
    name = "pypi_test_b",
    dependency_groups = ["group:test;testonly"],
    projects = ["app-b"],
    workspace = "mono",
)
use_repo(uv, "pypi", "pypi_test_a", "pypi_test_b")
