# Tagged manual: under glibc 2.17, cbor2 has no matching wheel and falls back to
# building from sdist (which fails because build/setuptools are not in uv.lock).
transitioned_pkg(
    name = "cbor2_glibc_2_17_whl",
    libc = "glibc",
    tags = ["manual"],
    target = "@pypi//cbor2:whl",
    version = "2.17",
)
