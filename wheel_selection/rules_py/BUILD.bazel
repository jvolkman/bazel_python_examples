load("@rules_py//py:defs.bzl", "py_test")
load(":transition.bzl", "transitioned_pkg")

exports_files([
    "project/pyproject.toml",
    "project/uv.lock",
])

# 1. Default Linux x86_64: platform_version defaults to the host's probed glibc
#    (on glibc >= 2.34 hosts this picks manylinux_2_34; on older hosts it picks
#    manylinux_2_28 or manylinux_2_17).
py_test(
    name = "bcrypt_default_test",
    srcs = ["project/src/check_wheel.py"],
    args = ["dist", "bcrypt", "cp39-abi3-manylinux_2_34_x86_64"],
    dep_group = "wheel-selection-app",
    main = "project/src/check_wheel.py",
    deps = ["@pypi//bcrypt"],
)

py_test(
    name = "cbor2_default_test",
    srcs = ["project/src/check_wheel.py"],
    args = ["dist", "cbor2", "cp312-cp312-manylinux_2_28_x86_64"],
    dep_group = "wheel-selection-app",
    main = "project/src/check_wheel.py",
    deps = ["@pypi//cbor2"],
)

# 2. Explicit glibc 2.17 / 2.28 / 2.34 via rules_py's private platform_* flags
transitioned_pkg(
    name = "bcrypt_glibc_2_17_whl",
    libc = "glibc",
    target = "@pypi//bcrypt:whl",
    version = "2.17",
)

py_test(
    name = "bcrypt_glibc_2_17_test",
    srcs = ["project/src/check_wheel.py"],
    args = ["whl", "$(rootpath :bcrypt_glibc_2_17_whl)", "cp39-abi3-manylinux_2_17_x86_64"],
    data = [":bcrypt_glibc_2_17_whl"],
    dep_group = "wheel-selection-app",
    main = "project/src/check_wheel.py",
)

transitioned_pkg(
    name = "bcrypt_glibc_2_28_whl",
